#!/usr/bin/env python3
"""Washington State Ferries provider for the Omarchy Ferries widget.

Talks to the WSDOT Ferries REST API and the public VesselWatch camera feed,
and prints ONE normalized JSON document on stdout. The shape is documented in
providers/README.md; the QML side renders that shape and nothing else, so a
provider for another ferry system only has to produce the same document.

    fetch --route "Bainbridge Island - Seattle" [--key CODE] [--now EPOCH]
          [--cache-dir DIR] [--fixtures DIR] [--no-network]

Everything here is bounded on purpose. Responses are read up to a byte cap
and rejected past it, every array in the output has a length cap, every
string has a length cap and control characters stripped. The document ends
up inside a long-running shell process that owns the whole bar; a hostile or
merely broken upstream response must not be able to grow it.

Standard library only. No third-party packages.
"""

import argparse
import datetime as dt
import hashlib
import json
import os
import re
import sys
import time
import urllib.error
import urllib.parse
import urllib.request

try:
    from zoneinfo import ZoneInfo
except ImportError:  # pragma: no cover
    ZoneInfo = None

SCHEMA = 1
API = "https://www.wsdot.wa.gov/ferries/api"
CAMERA_FEED = "https://wsdot.com/ferries/vesselwatch/Cameras.ashx"
USER_AGENT = "omarchy-ferries/1.0 (+https://github.com/jampick/omarchy-ferries)"

MAX_RESPONSE_BYTES = 2 * 1024 * 1024   # a full vessellocations is ~40 KiB
HTTP_TIMEOUT = 10

MAX_DEPARTURES = 64
MAX_VESSELS = 16
MAX_ALERTS = 20
MAX_BULLETINS = 10
MAX_WAITS = 6
MAX_CAMERAS = 8
MAX_ROUTES = 80
MAX_TEXT = 600
MAX_TITLE = 160
MAX_NAME = 64

# Cache time-to-live per endpoint, seconds. Positions and sailing space are
# live; the rest changes slowly and WSDOT asks callers not to hammer them.
TTL = {
    "vessellocations": 0,
    "sailingspace": 0,
    "schedule": 15 * 60,
    "alerts": 5 * 60,
    "bulletins": 10 * 60,
    "waittimes": 5 * 60,
    "routes": 24 * 3600,
    "terminalsandmates": 24 * 3600,
    "terminallocations": 24 * 3600,
    "cameras": 24 * 3600,
}

# Same-day WSF turnaround at a dock is normally a few minutes; if the inbound
# boat's ETA is later than this many seconds before the departure, that
# departure cannot leave on time. Kept small on purpose: it is a floor.
MIN_TURNAROUND_SEC = 3 * 60
# A boat that is still at the dock this long after its scheduled time is late.
LATE_GRACE_SEC = 60
# How far into the past a sailing is still listed so a late boat does not
# vanish from "next" the moment the clock passes its scheduled time.
PAST_WINDOW_SEC = 45 * 60

HERE = os.path.dirname(os.path.abspath(__file__))


# ---------------------------------------------------------------------------
# Small helpers
# ---------------------------------------------------------------------------

_CONTROL = re.compile(r"[\x00-\x08\x0b\x0c\x0e-\x1f\x7f]")
_WS = re.compile(r"[ \t\r\f\v]+")


def clean(value, limit=MAX_TEXT):
    """Trim, strip control characters, collapse whitespace, cap length."""
    if value is None:
        return ""
    text = str(value)
    text = _CONTROL.sub("", text)
    text = re.sub(r"<[^>]{0,200}>", " ", text)  # bulletins carry HTML
    text = text.replace("&nbsp;", " ").replace("&amp;", "&").replace("&lt;", "<").replace("&gt;", ">").replace("&quot;", '"').replace("&#39;", "'")
    text = _WS.sub(" ", text)
    text = re.sub(r"\n\s*\n+", "\n", text).strip()
    if len(text) > limit:
        text = text[: limit - 1].rstrip() + "…"
    return text


def num(value, default=None):
    try:
        if value is None or value == "":
            return default
        out = float(value)
        if out != out or out in (float("inf"), float("-inf")):
            return default
        return out
    except (TypeError, ValueError):
        return default


def integer(value, default=None):
    out = num(value, None)
    if out is None:
        return default
    return int(out)


_DOTNET_DATE = re.compile(r"Date\((-?\d+)(?:[+-]\d{4})?\)")


def epoch(value):
    """WSDOT emits WCF dates: "/Date(1693260300000-0700)/". The number is UTC
    milliseconds; the suffix is decorative. Returns integer seconds or None."""
    if value is None:
        return None
    if isinstance(value, (int, float)):
        return int(value)
    match = _DOTNET_DATE.search(str(value))
    if not match:
        return None
    return int(match.group(1)) // 1000


def local_zone(name):
    if ZoneInfo is None:
        return None
    try:
        return ZoneInfo(name)
    except Exception:
        return None


def time_label(seconds, zone):
    if seconds is None:
        return ""
    when = dt.datetime.fromtimestamp(seconds, tz=zone or dt.timezone.utc)
    label = when.strftime("%I:%M %p").lstrip("0")
    return label


def when_label(seconds, now, zone):
    """Clock time for today, a date for anything else. A wait-time note last
    touched in 2020 must not read as "12:31 PM"."""
    if seconds is None:
        return ""
    if day_key(seconds, zone) == day_key(now, zone):
        return time_label(seconds, zone)
    when = dt.datetime.fromtimestamp(seconds, tz=zone or dt.timezone.utc)
    return when.strftime("%b %d, %Y") if when.year != dt.datetime.fromtimestamp(now, tz=zone or dt.timezone.utc).year else when.strftime("%b %d, %I:%M %p").replace(", 0", ", ")


def day_key(seconds, zone):
    when = dt.datetime.fromtimestamp(seconds, tz=zone or dt.timezone.utc)
    return when.strftime("%Y-%m-%d")


def norm(text):
    return re.sub(r"[^a-z0-9]+", "", str(text or "").lower())


# ---------------------------------------------------------------------------
# HTTP with caching
# ---------------------------------------------------------------------------

class Source:
    """Fetches JSON with a byte cap, a timeout, and a disk cache that also
    serves stale data when the network is down. `fixtures` replaces the
    network entirely for tests."""

    def __init__(self, cache_dir, fixtures=None, offline=False, now=None):
        self.cache_dir = cache_dir
        self.fixtures = fixtures
        self.offline = offline
        self.now = now or int(time.time())
        self.errors = []
        self.calls = 0

    def _cache_path(self, name):
        return os.path.join(self.cache_dir, name + ".json")

    def _read_cache(self, name):
        try:
            with open(self._cache_path(name), "r", encoding="utf-8") as fh:
                blob = json.load(fh)
            if not isinstance(blob, dict) or "body" not in blob:
                return None
            return blob
        except (OSError, ValueError):
            return None

    def _write_cache(self, name, body):
        try:
            os.makedirs(self.cache_dir, mode=0o700, exist_ok=True)
            tmp = self._cache_path(name) + ".tmp"
            with open(tmp, "w", encoding="utf-8") as fh:
                json.dump({"fetchedAt": self.now, "body": body}, fh)
            os.replace(tmp, self._cache_path(name))
        except OSError:
            pass

    def _http(self, url):
        req = urllib.request.Request(url, headers={"User-Agent": USER_AGENT, "Accept": "application/json"})
        with urllib.request.urlopen(req, timeout=HTTP_TIMEOUT) as resp:
            raw = resp.read(MAX_RESPONSE_BYTES + 1)
        if len(raw) > MAX_RESPONSE_BYTES:
            raise ValueError("response over %d bytes" % MAX_RESPONSE_BYTES)
        return json.loads(raw.decode("utf-8", "replace"))

    def get(self, name, url, ttl):
        """Return (body, fromCache). Cached copies inside their TTL are served
        without touching the network; on any failure the stale copy is used."""
        if self.fixtures is not None:
            path = os.path.join(self.fixtures, name + ".json")
            try:
                with open(path, "r", encoding="utf-8") as fh:
                    return json.load(fh), False
            except (OSError, ValueError) as exc:
                self.errors.append("%s: fixture missing (%s)" % (name, exc.__class__.__name__))
                return None, False

        cached = self._read_cache(name)
        if cached is not None and ttl > 0 and self.now - int(cached.get("fetchedAt") or 0) < ttl:
            return cached["body"], True

        if self.offline:
            return (cached["body"] if cached else None), True

        try:
            self.calls += 1
            body = self._http(url)
            self._write_cache(name, body)
            return body, False
        except urllib.error.HTTPError as exc:
            self.errors.append("%s: HTTP %s" % (name, exc.code))
            if exc.code in (401, 403):
                self.errors.append("api key rejected")
        except (urllib.error.URLError, OSError, ValueError) as exc:
            self.errors.append("%s: %s" % (name, exc.__class__.__name__))
        return (cached["body"] if cached else None), True


# ---------------------------------------------------------------------------
# Static provider metadata
