# Main
# ---------------------------------------------------------------------------

def build(args):
    meta = load_provider_meta()
    zone = local_zone(meta.get("timezone", "America/Los_Angeles"))
    now = args.now or int(time.time())
    cache_dir = args.cache_dir or os.path.join(
        os.environ.get("XDG_CACHE_HOME") or os.path.join(os.path.expanduser("~"), ".cache"),
        "omarchy-ferries", "wsdot")
    src = Source(cache_dir, fixtures=args.fixtures, offline=args.no_network, now=now)

    doc = {
        "schema": SCHEMA,
        "provider": meta["id"],
        "providerName": meta["name"],
        "generatedAt": now,
        "timezone": meta.get("timezone", ""),
        "ok": False,
        "error": "",
        "errors": [],
        "route": None,
        "departures": [],
        "vessels": [],
        "alerts": [],
        "bulletins": [],
        "waitTimes": [],
        "cameras": [],
        "routes": [],
        "links": dict(meta.get("links", {})),
    }

    key = find_key(args.key)
    if not key and args.fixtures is None:
        doc["error"] = "no api key"
        doc["links"]["apiRegistration"] = meta["links"]["apiRegistration"]
        # The camera feed and terminal table need no key, so a fresh install
        # still shows something real while the code is on its way.
        terminals = meta["terminals"]
        a_tok, b_tok = split_route(args.route)
        a = resolve_terminal(a_tok, terminals)
        b = resolve_terminal(b_tok, terminals)
        if a and b:
            doc["route"] = {"id": None, "abbrev": "", "name": a["name"] + " → " + b["name"],
                            "from": public_terminal(a), "to": public_terminal(b), "links": {}}
            cams, _ = src.get("cameras", CAMERA_FEED, TTL["cameras"])
            doc["cameras"] = normalize_cameras(cams, a["id"])
        return doc

    def api(name, path, ttl):
        url = API + path + ("&" if "?" in path else "?") + "apiaccesscode=" + urllib.parse.quote(key)
        return src.get(name, url, ttl)

    # Terminals: live coordinates and names merged over the static table.
    live_terms, _ = api("terminallocations", "/terminals/rest/terminallocations", TTL["terminallocations"])
    terminals = merge_terminal_locations(meta["terminals"], live_terms)

    a_tok, b_tok = split_route(args.route)
    a = resolve_terminal(a_tok, terminals)
    b = resolve_terminal(b_tok, terminals)
    if a is None or b is None or a["id"] == b["id"]:
        doc["error"] = "unknown route: %s" % clean(args.route, 80)
        mates, _ = api("terminalsandmates", "/schedule/rest/terminalsandmates/" + day_key(now, zone), TTL["terminalsandmates"])
        doc["routes"] = normalize_routes(mates, terminals)
        doc["errors"] = src.errors[:8]
        return doc

    today = day_key(now, zone)
    routes_raw, _ = api("routes-%d-%d" % (a["id"], b["id"]), "/schedule/rest/routes/%s/%d/%d" % (today, a["id"], b["id"]), TTL["routes"])
    route_ids, route_abbrevs, route_name = [], [], ""
    if isinstance(routes_raw, list):
        for r in routes_raw:
            if not isinstance(r, dict):
                continue
            rid = integer(r.get("RouteID"))
            if rid is not None:
                route_ids.append(rid)
            ab = clean(r.get("RouteAbbrev"), 16)
            if ab:
                route_abbrevs.append(ab)
            if not route_name:
                route_name = clean(r.get("Description"), MAX_NAME)

    sched_raw, _ = api("schedule-%d-%d-%s" % (a["id"], b["id"], today),
                       "/schedule/rest/scheduletoday/%d/%d/false" % (a["id"], b["id"]), TTL["schedule"])
    times, notes, annotations, pdf = schedule_times(sched_raw, a["id"], b["id"])
    for t in times:
        for rid in t.get("routes") or []:
            if rid not in route_ids:
                route_ids.append(rid)

    vessels_raw, _ = api("vessellocations", "/vessels/rest/vessellocations", TTL["vessellocations"])
    vessels = normalize_vessels(vessels_raw, a["id"], b["id"], route_abbrevs, zone)

    space_raw, _ = api("sailingspace-%d" % a["id"], "/terminals/rest/terminalsailingspace/%d" % a["id"], TTL["sailingspace"])
    space = sailing_space(space_raw, b["id"])

    doc["departures"] = build_departures(times, space, vessels, now, a["id"], zone)
    doc["vessels"] = vessels

    alerts_raw, _ = api("alerts", "/schedule/rest/alerts", TTL["alerts"])
    doc["alerts"] = normalize_alerts(alerts_raw, route_ids, zone, now)

    bulletins_raw, _ = api("bulletins-%d" % a["id"], "/terminals/rest/terminalbulletins/%d" % a["id"], TTL["bulletins"])
    doc["bulletins"] = normalize_bulletins(bulletins_raw, zone, now, {norm(a["title"]) for a in doc["alerts"]})

    waits_raw, _ = api("waittimes-%d" % a["id"], "/terminals/rest/terminalwaittimes/%d" % a["id"], TTL["waittimes"])
    waits = normalize_waits(waits_raw, zone, now)
    if route_ids:
        matching = [w for w in waits if w.get("routeId") in route_ids]
        waits = matching or waits
    doc["waitTimes"] = waits

    cams_raw, _ = src.get("cameras", CAMERA_FEED, TTL["cameras"])
    doc["cameras"] = normalize_cameras(cams_raw, a["id"])

    mates_raw, _ = api("terminalsandmates", "/schedule/rest/terminalsandmates/" + today, TTL["terminalsandmates"])
    doc["routes"] = normalize_routes(mates_raw, terminals)

    pages = route_pages(meta, a["id"], b["id"]) or {}
    links = {
        "schedule": "https://wsdot.com/ferries/schedule/scheduledetailbyroute.aspx?route=" + pages["schedule"] if pages.get("schedule") else meta["links"]["schedule"],
        "schedulePdf": pdf,
        "map": "https://wsdot.com/ferries/vesselwatch/default.aspx?view=" + pages.get("map", "sea"),
        "alerts": meta["links"]["alerts"],
        "terminal": "https://wsdot.com/ferries/vesselwatch/TerminalDetail.aspx?terminalid=%d" % a["id"],
        "cameras": "https://wsdot.com/ferries/vesselwatch/cameradetail.aspx?terminalid=%d" % a["id"],
    }
    doc["route"] = {
        "id": route_ids[0] if route_ids else None,
        "ids": route_ids[:6],
        "abbrev": route_abbrevs[0] if route_abbrevs else "",
        "name": route_name or (a["name"] + " / " + b["name"]),
        "from": public_terminal(a),
        "to": public_terminal(b),
        "notes": notes,
        "annotations": annotations,
        "links": links,
    }
    doc["errors"] = src.errors[:8]
    # "ok" means the live sailing list exists. Missing extras (alerts, cameras)
    # degrade the panel; a missing schedule empties it.
    doc["ok"] = bool(times) or bool(space)
    if not doc["ok"]:
        if any("api key rejected" in e for e in src.errors):
            doc["error"] = "api key rejected"
        elif src.errors:
            doc["error"] = "offline: " + src.errors[0]
        else:
            doc["error"] = "no sailings today for this route"
    return doc


def main(argv):
    parser = argparse.ArgumentParser(description=__doc__.split("\n")[0])
    parser.add_argument("--route", default="Bainbridge Island - Seattle")
    parser.add_argument("--key", default="")
    parser.add_argument("--now", type=int, default=None, help="epoch seconds, for tests")
    parser.add_argument("--cache-dir", default=None)
    parser.add_argument("--fixtures", default=None, help="directory of recorded API responses instead of the network")
    parser.add_argument("--no-network", action="store_true", help="serve only from cache")
    parser.add_argument("--pretty", action="store_true")
    args = parser.parse_args(argv)
    try:
        doc = build(args)
    except Exception as exc:  # never let a traceback be the document
        doc = {"schema": SCHEMA, "provider": "wsdot", "ok": False, "error": "provider crashed: " + exc.__class__.__name__,
               "generatedAt": args.now or int(time.time()), "departures": [], "vessels": [], "alerts": [],
               "bulletins": [], "waitTimes": [], "cameras": [], "routes": [], "errors": [clean(str(exc), 200)]}
    if args.pretty:
        json.dump(doc, sys.stdout, indent=2, ensure_ascii=False)
    else:
        json.dump(doc, sys.stdout, separators=(",", ":"), ensure_ascii=False)
    sys.stdout.write("\n")
    return 0 if doc.get("ok") or doc.get("error") in ("no api key",) else 1


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
