def load_provider_meta():
    with open(os.path.join(HERE, "provider.json"), "r", encoding="utf-8") as fh:
        return json.load(fh)


def find_key(explicit):
    """Setting, then environment, then a file the user owns. The file exists
    for people who would rather not have the code sit in shell.json."""
    if explicit and explicit.strip():
        return explicit.strip()
    env = os.environ.get("WSDOT_ACCESS_CODE", "").strip()
    if env:
        return env
    home = os.environ.get("XDG_CONFIG_HOME") or os.path.join(os.path.expanduser("~"), ".config")
    path = os.path.join(home, "omarchy-ferries", "wsdot-access-code")
    try:
        with open(path, "r", encoding="utf-8") as fh:
            return fh.read().strip()
    except OSError:
        return ""


def resolve_terminal(token, terminals):
    """Accept an id, an abbreviation, an exact name, or a unique name prefix."""
    needle = norm(token)
    if not needle:
        return None
    for term in terminals:
        if needle == str(term["id"]) or needle == norm(term["abbrev"]) or needle == norm(term["name"]):
            return term
    prefix = [t for t in terminals if norm(t["name"]).startswith(needle)]
    if len(prefix) == 1:
        return prefix[0]
    return None


def split_route(text):
    parts = re.split(r"\s*(?:->|→|>|\bto\b|-|/)\s*", str(text or ""), maxsplit=1)
    if len(parts) != 2:
        return None, None
    return parts[0].strip(), parts[1].strip()


def merge_terminal_locations(static, live):
    """Live coordinates and names win when present; the static table is the
    fallback for a cold start with no network."""
    if not isinstance(live, list):
        return static
    by_id = {t["id"]: dict(t) for t in static}
    for row in live:
        if not isinstance(row, dict):
            continue
        tid = integer(row.get("TerminalID"))
        if tid is None:
            continue
        entry = by_id.get(tid, {"id": tid, "abbrev": "", "name": ""})
        entry["name"] = clean(row.get("TerminalName"), MAX_NAME) or entry.get("name", "")
        entry["abbrev"] = clean(row.get("TerminalAbbrev"), 8) or entry.get("abbrev", "")
        lat, lon = num(row.get("Latitude")), num(row.get("Longitude"))
        if lat is not None and lon is not None and -90 <= lat <= 90 and -180 <= lon <= 180:
            entry["lat"], entry["lon"] = lat, lon
        by_id[tid] = entry
    return sorted(by_id.values(), key=lambda t: t.get("name", ""))


def route_pages(meta, a, b):
    for page in meta.get("routePages", []):
        pair = set(page.get("terminals", []))
        if pair == {a, b}:
            return page
    return None


def public_terminal(term):
    return {
        "id": term["id"],
        "name": term.get("name", ""),
        "abbrev": term.get("abbrev", ""),
        "lat": term.get("lat"),
        "lon": term.get("lon"),
    }


# ---------------------------------------------------------------------------
# Normalization
# ---------------------------------------------------------------------------

def normalize_vessels(raw, a, b, route_abbrevs, zone):
    """Vessels that belong to this route: either endpoint is one of ours, or
    WSDOT tags the vessel with the route abbreviation."""
    out = []
    if not isinstance(raw, list):
        return out
    wanted = {norm(x) for x in route_abbrevs}
    for row in raw:
        if not isinstance(row, dict):
            continue
        dep_id = integer(row.get("DepartingTerminalID"))
        arr_id = integer(row.get("ArrivingTerminalID"))
        ops = row.get("OpRouteAbbrev") or []
        tagged = any(norm(x) in wanted for x in ops if isinstance(x, str)) if wanted else False
        # Both ends must be ours: Seattle's dock serves Bremerton boats too,
        # and one shared terminal is not the same route.
        on_route = dep_id in (a, b) and arr_id in (a, b) and dep_id != arr_id
        if not (tagged or on_route):
            continue
        lat, lon = num(row.get("Latitude")), num(row.get("Longitude"))
        left = epoch(row.get("LeftDock"))
        sched = epoch(row.get("ScheduledDeparture"))
        eta = epoch(row.get("Eta"))
        delay = None
        if left is not None and sched is not None:
            delay = int(round((left - sched) / 60.0))
        out.append({
            "id": integer(row.get("VesselID")),
            "name": clean(row.get("VesselName"), MAX_NAME),
            "lat": lat, "lon": lon,
            "speed": num(row.get("Speed")),
            "heading": integer(row.get("Heading")),
            "atDock": bool(row.get("AtDock")),
            "inService": bool(row.get("InService", True)),
            "fromId": dep_id, "from": clean(row.get("DepartingTerminalName"), MAX_NAME),
            "toId": arr_id, "to": clean(row.get("ArrivingTerminalName"), MAX_NAME),
            "eta": eta, "etaLabel": time_label(eta, zone),
            "etaBasis": clean(row.get("EtaBasis"), MAX_TITLE),
            "leftDock": left, "leftDockLabel": time_label(left, zone),
            "scheduledDeparture": sched, "scheduledDepartureLabel": time_label(sched, zone),
            "delayMin": delay,
            # VesselWatchMsg is a site-wide status line ("VesselWatch is out of
            # service") stamped on every vessel; only the per-vessel shutdown
            # message, and only when its flag is set, says anything about this boat.
            "notice": clean(row.get("VesselWatchShutMsg"), MAX_TITLE) if str(row.get("VesselWatchShutFlag", "0")).strip().lower() in ("1", "true") else "",
            "updated": epoch(row.get("TimeStamp")),
        })
        if len(out) >= MAX_VESSELS:
            break
    return out


def schedule_times(raw, a, b):
    """Today's sailings A->B from the schedule endpoint, plus the combo's notes
    and the PDF link for the season."""
    times, notes, annotations, pdf = [], "", [], ""
    if not isinstance(raw, dict):
        return times, notes, annotations, pdf
    pdf = clean(raw.get("SchedulePDFUrl"), 300)
    if pdf.startswith("http://") and ".wsdot.wa.gov/" in pdf:
        pdf = "https://" + pdf[len("http://"):]
    if pdf and not pdf.startswith("https://"):
        pdf = ""
    for combo in raw.get("TerminalCombos") or []:
        if not isinstance(combo, dict):
            continue
        if integer(combo.get("DepartingTerminalID")) != a or integer(combo.get("ArrivingTerminalID")) != b:
            continue
        notes = clean(combo.get("SailingNotes"), MAX_TEXT)
        annotations = [clean(x, MAX_TITLE) for x in (combo.get("Annotations") or []) if isinstance(x, str)][:12]
        for row in combo.get("Times") or []:
            if not isinstance(row, dict):
                continue
            when = epoch(row.get("DepartingTime"))
            if when is None:
                continue
            idx = [i for i in (row.get("AnnotationIndexes") or []) if isinstance(i, int) and 0 <= i < len(annotations)]
            times.append({
                "time": when,
                "arrival": epoch(row.get("ArrivingTime")),
                "vesselId": integer(row.get("VesselID")),
                "vessel": clean(row.get("VesselName"), MAX_NAME),
                "routes": [integer(r) for r in (row.get("Routes") or []) if integer(r) is not None],
                "annotations": [annotations[i] for i in idx][:4],
            })
    times.sort(key=lambda t: t["time"])
    return times, notes, annotations, pdf


def sailing_space(raw, b):
    """Departure time -> space record for sailings whose arrival list includes
    terminal B. WSDOT publishes this only for select departures, so a miss is
    normal and means 'unknown', not 'zero'."""
    out = {}
    if isinstance(raw, list):
        raw = raw[0] if raw and isinstance(raw[0], dict) else {}
    if not isinstance(raw, dict):
        return out
    for dep in raw.get("DepartingSpaces") or []:
        if not isinstance(dep, dict):
            continue
        when = epoch(dep.get("Departure"))
        if when is None:
            continue
        record = {
            "cancelled": bool(dep.get("IsCancelled")),
            "vessel": clean(dep.get("VesselName"), MAX_NAME),
            "vesselId": integer(dep.get("VesselID")),
            "maxSpace": integer(dep.get("MaxSpaceCount")),
            "driveUp": None, "reservable": None, "showReservable": False, "spaceKnown": False,
        }
        for arr in dep.get("SpaceForArrivalTerminals") or []:
            if not isinstance(arr, dict):
                continue
            ids = {integer(x) for x in (arr.get("ArrivalTerminalIDs") or [])}
            ids.add(integer(arr.get("TerminalID")))
            if b not in ids:
                continue
            if arr.get("DisplayDriveUpSpace", True):
                record["driveUp"] = integer(arr.get("DriveUpSpaceCount"))
            record["showReservable"] = bool(arr.get("DisplayReservableSpace"))
            if record["showReservable"]:
                record["reservable"] = integer(arr.get("ReservableSpaceCount"))
            record["maxSpace"] = integer(arr.get("MaxSpaceCount"), record["maxSpace"])
            record["spaceKnown"] = record["driveUp"] is not None
            break
        out[when] = record
    return out


def find_boat(dep, vessels):
    for v in vessels:
        if dep.get("vesselId") is not None and v.get("id") == dep.get("vesselId"):
            return v
        if dep.get("vessel") and norm(v.get("name")) == norm(dep.get("vessel")):
            return v
    return None


def classify(dep, boat, now, live_taken):
    """Decide what a sailing is doing right now from the vessel feed.

    `boat` is the vessel assigned to it (or None); `live_taken` says whether
    an earlier sailing on the same boat already claimed its live state. A
    boat sitting at the dock is at the dock for ONE sailing, the next one on
    its rotation, so later sailings on the same boat stay "scheduled".

    Returns (status, delayMin, basis). Statuses:
      cancelled  WSDOT says so
      departed   the boat has left our dock for this sailing (or the sailing
                 is in the past and the boat is not here for it)
      late       past scheduled time and the boat is still at the dock, or
                 the inbound boat's ETA makes an on-time departure impossible
      at-dock    the boat is tied up at our terminal ahead of this sailing
      inbound    the boat is on its way to our terminal for this sailing
      scheduled  nothing live to say yet
    delayMin is an estimate and basis says where it came from, because a
    figure without provenance invites more trust than it has earned."""
    if dep.get("cancelled"):
        return "cancelled", None, "operator"
    when = dep["time"]
    past = now > when + LATE_GRACE_SEC
    if boat is None:
        return ("departed" if past else "scheduled"), None, ""

    here = dep["fromId"]
    sched = boat.get("scheduledDeparture")
    left = boat.get("leftDock")
    at_our_dock = bool(boat.get("atDock")) and boat.get("fromId") == here
    inbound_to_us = not boat.get("atDock") and boat.get("toId") == here

    # The boat has sailed on this very sailing.
    if not boat.get("atDock") and boat.get("fromId") == here and sched == when and left is not None:
        return "departed", int(round((left - when) / 60.0)), "left dock"

    if past:
        # Still here past its time, and this is the sailing it is here for.
        if at_our_dock and not live_taken and (sched is None or sched <= when + LATE_GRACE_SEC):
            return "late", int(round((now - when) / 60.0)), "still at dock"
        return "departed", None, ""

    if live_taken:
        return "scheduled", None, ""

    if at_our_dock:
        return "at-dock", 0, "at dock"

    # The boat is coming to us. If it cannot arrive and turn around in time,
    # say so now rather than at the scheduled minute.
    if inbound_to_us:
        eta = boat.get("eta")
        if eta is not None and when < now + 3 * 3600:
            slack = when - (eta + MIN_TURNAROUND_SEC)
            if slack < 0:
                return "late", int(round(-slack / 60.0)), "inbound ETA " + (boat.get("etaLabel") or "")
        return "inbound", 0, "inbound"

    return "scheduled", None, ""


def build_departures(times, space, vessels, now, a, zone):
    out = []
    for row in times:
        when = row["time"]
        if when < now - PAST_WINDOW_SEC and not (row.get("annotations")):
            pass  # still listed: the full-day view wants the whole day
        rec = {
            "time": when,
            "timeLabel": time_label(when, zone),
            "arrival": row.get("arrival"),
            "arrivalLabel": time_label(row.get("arrival"), zone),
            "vessel": row.get("vessel") or "",
            "vesselId": row.get("vesselId"),
            "fromId": a,
            "routes": row.get("routes") or [],
            "annotations": row.get("annotations") or [],
            "cancelled": False,
            "driveUp": None, "reservable": None, "showReservable": False, "maxSpace": None, "spaceKnown": False,
        }
        sp = space.get(when)
        if sp:
            rec.update({k: sp[k] for k in ("cancelled", "driveUp", "reservable", "showReservable", "maxSpace", "spaceKnown")})
            if sp.get("vessel") and not rec["vessel"]:
                rec["vessel"] = sp["vessel"]
                rec["vesselId"] = sp.get("vesselId")
            elif sp.get("vessel") and norm(sp["vessel"]) != norm(rec["vessel"]):
                # Sailing space is the more current of the two feeds: WSF
                # swaps boats during the day and the schedule lags.
                rec["vessel"] = sp["vessel"]
                rec["vesselId"] = sp.get("vesselId")
        out.append(rec)
    # Sailing-space rows that the schedule did not list (extra sailings).
    listed = {r["time"] for r in out}
    for when, sp in space.items():
        if when in listed:
            continue
        rec = {
            "time": when, "timeLabel": time_label(when, zone), "arrival": None, "arrivalLabel": "",
            "vessel": sp.get("vessel") or "", "vesselId": sp.get("vesselId"), "fromId": a, "routes": [],
            "annotations": ["Added sailing"], "cancelled": sp["cancelled"], "driveUp": sp["driveUp"],
            "reservable": sp["reservable"], "showReservable": sp["showReservable"], "maxSpace": sp["maxSpace"],
            "spaceKnown": sp["spaceKnown"],
        }
        out.append(rec)
    out.sort(key=lambda r: r["time"])
    out = out[:MAX_DEPARTURES]

    # Live state is handed out in time order, once per boat: the first
    # sailing a boat has not yet completed gets at-dock / inbound / late, and
    # the rest of its rotation stays "scheduled" until its turn comes.
    live_taken = set()
    for rec in out:
        boat = find_boat(rec, vessels)
        key = boat.get("id") if boat else None
        status, delay, basis = classify(rec, boat, now, key in live_taken)
        rec["status"], rec["delayMin"], rec["basis"] = status, delay, basis
        if key is not None and status in ("late", "at-dock", "inbound"):
            live_taken.add(key)
    return out


def normalize_alerts(raw, route_ids, zone, now):
    out = []
    if not isinstance(raw, list):
        return out
    wanted = set(route_ids)
    rows = [r for r in raw if isinstance(r, dict)]
    rows.sort(key=lambda r: epoch(r.get("PublishDate")) or 0, reverse=True)
    for row in rows:
        affected = {integer(x) for x in (row.get("AffectedRouteIDs") or [])}
        all_routes = bool(row.get("AllRoutesFlag"))
        if not all_routes and wanted and not (affected & wanted):
            continue
        title = clean(row.get("AlertFullTitle") or row.get("BulletinText"), MAX_TITLE)
        text = clean(row.get("BulletinText") or row.get("RouteAlertText") or row.get("CommunicationText"), MAX_TEXT)
        if not title and not text:
            continue
        published = epoch(row.get("PublishDate"))
        out.append({
            "id": integer(row.get("BulletinID")),
            "title": title or text[:MAX_TITLE],
            "text": text,
            "type": clean(row.get("AlertType"), 40),
            "published": published,
            "publishedLabel": when_label(published, now, zone),
            "allRoutes": all_routes,
        })
        if len(out) >= MAX_ALERTS:
            break
    return out


def normalize_bulletins(raw, zone, now, skip_titles=()):
    out = []
    if isinstance(raw, list):
        raw = raw[0] if raw and isinstance(raw[0], dict) else {}
    if not isinstance(raw, dict):
        return out
    rows = [b for b in (raw.get("Bulletins") or []) if isinstance(b, dict)]
    rows.sort(key=lambda b: integer(b.get("BulletinSortSeq"), 0))
    for b in rows:
        title = clean(b.get("BulletinTitle"), MAX_TITLE)
        text = clean(b.get("BulletinText"), MAX_TEXT)
        if not title and not text:
            continue
        # WSDOT mirrors route alerts into terminal bulletins; one copy is enough.
        if norm(title) in skip_titles:
            continue
        updated = epoch(b.get("BulletinLastUpdated"))
        out.append({"title": title or text[:MAX_TITLE], "text": text, "updated": updated, "updatedLabel": when_label(updated, now, zone)})
        if len(out) >= MAX_BULLETINS:
            break
    return out


def normalize_waits(raw, zone, now):
    out = []
    if isinstance(raw, list):
        raw = raw[0] if raw and isinstance(raw[0], dict) else {}
    if not isinstance(raw, dict):
        return out
    for w in raw.get("WaitTimes") or []:
        if not isinstance(w, dict):
            continue
        notes = clean(w.get("WaitTimeNotes"), MAX_TEXT)
        if not notes:
            continue
        updated = epoch(w.get("WaitTimeLastUpdated"))
        out.append({
            "routeId": integer(w.get("RouteID")),
            "route": clean(w.get("RouteName"), MAX_NAME),
            "notes": notes,
            "updated": updated,
            "updatedLabel": when_label(updated, now, zone),
        })
        if len(out) >= MAX_WAITS:
            break
    return out


def normalize_cameras(raw, terminal_id):
    out = []
    if not isinstance(raw, dict):
        return out
    for row in raw.get("FeedContentList") or []:
        if not isinstance(row, dict) or integer(row.get("TerminalID")) != terminal_id:
            continue
        cam = row.get("FerryCamera") or {}
        url = clean(cam.get("ImgURL"), 300)
        if not url.startswith("https://") or not cam.get("IsActive", True):
            continue
        out.append({
            "id": integer(cam.get("CamID")),
            "title": clean(cam.get("Title"), MAX_TITLE),
            "url": url,
            "lat": num(cam.get("Lat")), "lon": num(cam.get("Lon")),
            "terminalId": terminal_id,
        })
        if len(out) >= MAX_CAMERAS:
            break
    # Terminal-owned holding-lot cameras first; highway approach cameras after.
    out.sort(key=lambda c: (0 if c["title"].upper().startswith("WSF") else 1))
    return out


def normalize_routes(raw, terminals):
    """Every terminal pair WSDOT sails today, for the route picker."""
    out = []
    if not isinstance(raw, list):
        return out
    by_id = {t["id"]: t for t in terminals}
    seen = set()
    for row in raw:
        if not isinstance(row, dict):
            continue
        a, b = integer(row.get("DepartingTerminalID")), integer(row.get("ArrivingTerminalID"))
        if a is None or b is None or (a, b) in seen:
            continue
        seen.add((a, b))
        fa = by_id.get(a, {}).get("name") or clean(row.get("DepartingDescription"), MAX_NAME)
        fb = by_id.get(b, {}).get("name") or clean(row.get("ArrivingDescription"), MAX_NAME)
        out.append({"fromId": a, "from": fa, "toId": b, "to": fb, "label": fa + " → " + fb})
        if len(out) >= MAX_ROUTES:
            break
    out.sort(key=lambda r: (r["from"], r["to"]))
    return out


