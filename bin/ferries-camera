#!/usr/bin/env python3
"""Download one camera still into the runtime cache, bounded in size and
time. Prints the final path on success.

    ferries-camera URL DEST

Only https, and only from the hosts the operators serve stills from, so a
hostile document cannot turn this into a general-purpose downloader. The
body is read with a byte cap and rejected whole past it, checked for image
magic bytes before the shell ever tries to decode it, written to an
exclusively created 0600 temporary file in a directory we own, and renamed
into place. DEST is never opened for writing by pathname. Standard library
only."""

import os
import secrets
import stat
import sys
import urllib.error
import urllib.request

ALLOWED_HOSTS = ("images.wsdot.wa.gov", "www.seattle.gov")
ALLOWED_SUFFIX = (".wsdot.wa.gov",)
MAX_BYTES = int(os.environ.get("FERRIES_CAMERA_MAX_BYTES", str(3 * 1024 * 1024)))
TIMEOUT = 12
_NOFOLLOW = getattr(os, "O_NOFOLLOW", 0)
_CLOEXEC = getattr(os, "O_CLOEXEC", 0)


def host_allowed(url):
    if not url.startswith("https://"):
        return False
    host = url[len("https://"):].split("/", 1)[0].split("@")[-1].split(":")[0].lower()
    return host in ALLOWED_HOSTS or any(host.endswith(suffix) for suffix in ALLOWED_SUFFIX)


def looks_like_image(data):
    return data.startswith(b"\xff\xd8\xff") or data.startswith(b"\x89PNG\r\n\x1a\n")


def owned_private_dir(path):
    try:
        os.makedirs(path, mode=0o700, exist_ok=True)
        st = os.lstat(path)
        return stat.S_ISDIR(st.st_mode) and st.st_uid == os.getuid()
    except OSError:
        return False


def main(argv):
    if len(argv) != 2:
        sys.stderr.write("usage: ferries-camera URL DEST\n")
        return 2
    url, dest = argv
    if not host_allowed(url):
        sys.stderr.write("refusing camera host: %s\n" % url[:120])
        return 3
    directory, name = os.path.split(os.path.abspath(dest))
    if not name or name.startswith(".") or "/" in name:
        sys.stderr.write("bad destination name\n")
        return 2
    if not owned_private_dir(directory):
        sys.stderr.write("destination directory is not a private directory we own\n")
        return 1

    req = urllib.request.Request(url, headers={"User-Agent": "omarchy-ferries/1.0", "Cache-Control": "no-cache"})
    try:
        with urllib.request.urlopen(req, timeout=TIMEOUT) as resp:
            data = resp.read(MAX_BYTES + 1)
    except (urllib.error.URLError, OSError, ValueError) as exc:
        sys.stderr.write("download failed: %s\n" % exc.__class__.__name__)
        return 1
    if len(data) > MAX_BYTES:
        sys.stderr.write("still over %d bytes, discarded\n" % MAX_BYTES)
        return 1
    if not looks_like_image(data):
        sys.stderr.write("not an image: %s\n" % url[:120])
        return 1

    final = os.path.join(directory, name)
    try:
        st = os.lstat(final)
        if not stat.S_ISREG(st.st_mode):
            sys.stderr.write("destination exists and is not a regular file\n")
            return 1
    except FileNotFoundError:
        pass
    tmp = os.path.join(directory, ".%s.%s.part" % (name, secrets.token_hex(8)))
    try:
        fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_EXCL | _NOFOLLOW | _CLOEXEC, 0o600)
        with os.fdopen(fd, "wb") as fh:
            fh.write(data)
        os.replace(tmp, final)
    except OSError as exc:
        try:
            os.unlink(tmp)
        except OSError:
            pass
        sys.stderr.write("write failed: %s\n" % exc.__class__.__name__)
        return 1
    sys.stdout.write(final + "\n")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
